{
  "name": "Paper Minecraft",
  "slug": "paper-minecraft",
  "description": "Paper Minecraft Java server. Installs the requested Paper build before starting.",
  "author": "Control Plane",
  "spec": {
    "version": 1,
    "dockerImages": ["eclipse-temurin:25-jre"],
    "startup": "java -Xms128M -XX:MaxRAMPercentage=75 -jar /data/{{SERVER_JARFILE}} --nogui",
    "stop": "stop",
    "user": "1000:1000",
    "dataDirectory": "/data",
    "resources": {"cpuLimit": 2, "memoryMB": 2048},
    "install": {
      "image": "debian:bookworm-slim",
      "entrypoint": "/bin/bash",
      "scriptFile": "install.sh"
    },
    "environment": {"EULA": "TRUE"},
    "ports": [{"name": "Minecraft", "container": 25565, "protocol": "tcp"}],
    "variables": [
      {"name": "VERSION", "type": "text", "default": "LATEST", "ui": true, "description": "Paper version to install."},
      {"name": "SERVER_JARFILE", "type": "text", "default": "server.jar", "ui": true, "description": "Jar filename used by the startup command."}
    ]
  }
}
