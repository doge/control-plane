PANEL_ADDR=127.0.0.1:8080
MONGO_URI=mongodb://control-plane:change-this-password@localhost:27017/?authSource=admin
MONGO_DB=control-plane
SESSION_TTL_HOURS=168
STATIC_DIR=./web/dist

# Optional direct TLS termination (configure both paths together)
# PANEL_TLS_CERT_FILE=/etc/letsencrypt/live/panel.example.com/fullchain.pem
# PANEL_TLS_KEY_FILE=/etc/letsencrypt/live/panel.example.com/privkey.pem
